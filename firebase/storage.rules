rules_version = '2';
// Imágenes de producto en Firebase Storage.
// Binarios aquí; las URLs de descarga se guardan en Firestore (products.images).
service firebase.storage {
  match /b/{bucket}/o {
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return firestore.get(userPath()).data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(userPath())
        && userDoc().role == 'admin';
    }

    /**
     * Admin de una tienda (alineado con firestore.rules / auth.ts).
     * - Con adminStores no vacío: debe incluir storeId.
     * - Sin adminStores o vacío: solo tiendita / config (legacy).
     */
    function isStoreAdmin(storeId) {
      return isAdmin()
        && (
          (
            'adminStores' in userDoc()
            && userDoc().adminStores is list
            && userDoc().adminStores.size() > 0
            && storeId in userDoc().adminStores
          )
          || (
            (
              !('adminStores' in userDoc())
              || !(userDoc().adminStores is list)
              || userDoc().adminStores.size() == 0
            )
            && (storeId == 'tiendita' || storeId == 'config')
          )
        );
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    /** Comprobante de pago: imagen o PDF, máx. 10 MB. */
    function isReceiptUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    function isReceiptFileName(fileName) {
      return fileName.matches('receipt-.*');
    }

    // Producto existente: stores/{storeId}/products/{productId}/{filename}
    match /stores/{storeId}/products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isStoreAdmin(storeId) && isImageUpload();
      allow delete: if isStoreAdmin(storeId);
    }

    // Alta de producto (aún sin ID): stores/{storeId}/uploads/{uid}/{filename}
    match /stores/{storeId}/uploads/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isStoreAdmin(storeId)
        && request.auth.uid == userId
        && isImageUpload();
      allow delete: if isStoreAdmin(storeId) && request.auth.uid == userId;
    }

    /**
     * Comprobantes de pedido (checkout manual, con o sin login).
     * Path: stores/{storeId}/orders/{orderId|temp}/{uid|guest}/receipt-{uuid}.{ext}
     */
    match /stores/{storeId}/orders/{orderId}/{uploaderId}/{fileName} {
      allow read: if true;
      allow create: if isReceiptUpload()
        && isReceiptFileName(fileName)
        && (
          uploaderId == 'guest'
          || (isSignedIn() && request.auth.uid == uploaderId)
        );
      allow update: if false;
      allow delete: if isStoreAdmin(storeId);
    }

    // Ruta legacy /products/**
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUpload();
      allow delete: if isAdmin();
    }
  }
}
